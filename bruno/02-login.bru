meta {
  name: 02-login
  type: http
  seq: 2
}

post {
  url: http://localhost:8002/api/v1/auth/login
  body: json
  auth: none
}

body:json {
  {
    "username": "testuser",
    "password": "password"
  }
}

script:post-response {
  if(res.status == 200) {
    bru.setEnvVar("token", res.body.access_token);
  }
}
