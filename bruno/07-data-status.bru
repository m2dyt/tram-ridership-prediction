meta {
  name: 07-data-status
  type: http
  seq: 07
}

get {
  url: http://localhost:8000/api/v1/data-status
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}


script:post-response {
  if(res.status == 200) {
    bru.setEnvVar('dataset_revision_id', res.body.dataset_revision_id);
  }
}
