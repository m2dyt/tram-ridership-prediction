meta {
  name: 03-login
  type: http
  seq: 03
}

post {
  url: http://localhost:8002/api/v1/auth/login
  body: json
  auth: none
}

body:json {
  {"username": "newuser", "password": "newpassword"}
}

script:post-response {
  if(res.status == 200) {
    bru.setEnvVar('token', res.body.access_token);
  }
}
