meta {
  name: 13-create-forecast
  type: http
  seq: 13
}

post {
  url: http://localhost:8002/api/v1/forecast-runs
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  Idempotency-Key: run-demo-1
}

body:json {
{"dataset_revision_id": "demo-data-v1", "network_revision_id": "demo-network-v3", "profile_id": "demo-validations-day", "route_ids": ["demo-route-01"], "as_of": "2026-09-20T18:00:00+03:00", "forecast_start": "2026-09-21T00:00:00+03:00"}
}

script:post-response {
  if(res.status == 200) {
    bru.setEnvVar('run_id', res.body.id);
  }
}
