meta {
  name: 13-create-forecast
  type: http
  seq: 13
}

post {
  url: http://localhost:8000/api/v1/forecast-runs
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  Idempotency-Key: run-demo-1
}

body:json {
{"dataset_revision_id": "{{dataset_revision_id}}", "profile_id": "{{profile_id}}", "route_ids": ["demo-route-01"], "as_of": "{{as_of}}", "forecast_start": "{{forecast_start}}"}
}

script:post-response {
  if(res.status == 200) {
    bru.setEnvVar('run_id', res.body.id);
  }
}
