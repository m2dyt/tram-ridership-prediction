meta {
  name: 22-list-models
  type: http
  seq: 22
}

get {
  url: http://localhost:8000/api/v1/models
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

script:post-response {
  if(res.status == 200 && res.body.items.length > 0) {
    bru.setEnvVar('model_id', res.body.items[0].id);
  }
}
