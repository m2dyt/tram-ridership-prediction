meta {
  name: 06-capabilities
  type: http
  seq: 06
}

get {
  url: http://localhost:8000/api/v1/capabilities?dataset_revision_id={{dataset_revision_id}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}


script:post-response {
  if(res.status == 200) {
    let p = res.body.forecast_profiles[0];
    bru.setEnvVar('as_of', p.allowed_as_of_start);
    bru.setEnvVar('as_of_encoded', encodeURIComponent(p.allowed_as_of_start));
    bru.setEnvVar('forecast_start', p.forecast_start_min);
    bru.setEnvVar('forecast_start_encoded', encodeURIComponent(p.forecast_start_min));
    bru.setEnvVar('network_revision_id', res.body.network_revision_id);
    bru.setEnvVar('profile_id', p.id);
  }
}
