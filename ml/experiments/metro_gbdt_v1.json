{
  "experiment_name": "metro_gbdt_v1",
  "description": "Histogram gradient boosting trees on seasonal lags, calendar and network context",
  "model_type": "hist_gradient_boosting",
  "seed": 42,
  "train_start": "2021-Q1",
  "validation_start": "2024-Q1",
  "test_start": "2025-Q1",
  "test_end": "2026-Q3",
  "hyperparameters": {
    "max_iter": 150,
    "learning_rate": 0.03,
    "max_leaf_nodes": 31
  },
  "feature_columns": [
    "quarter_num",
    "year",
    "entrances_count",
    "lag_1",
    "lag_2",
    "lag_3",
    "lag_4",
    "lag_5",
    "rolling_mean_4",
    "trend_ratio_yoy"
  ],
  "categorical_columns": [
    "line"
  ]
}
