{
  "name": "tram-ridership-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0 <23 || >=24"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.js",
    "format": "prettier --write src tests vite.config.js package.json index.html",
    "format:check": "prettier --check src tests vite.config.js package.json index.html"
  },
  "dependencies": {
    "leaflet": "1.9.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "prettier": "3.8.1",
    "vite": "8.0.12"
  }
}
