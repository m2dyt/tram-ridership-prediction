# Prefer: python -m tram.cli init-config
# Replace every placeholder when configuring manually. Do not commit .env.
TRAM_POSTGRES_PASSWORD=replace-with-random-url-safe-password
TRAM_POSTGRES_PORT=15433
TRAM_DATABASE_URL=postgresql+psycopg://tram:replace-with-random-url-safe-password@127.0.0.1:15433/tram
TRAM_VIEWER_TOKEN=replace-with-a-unique-random-viewer-token
TRAM_OPERATOR_TOKEN=replace-with-a-unique-random-operator-token
TRAM_CURSOR_SECRET=replace-with-a-unique-random-cursor-secret
TRAM_CORS_ORIGINS=["http://localhost:5173","http://localhost:8081"]
TRAM_LEASE_SECONDS=120
TRAM_MAX_ATTEMPTS=3
TRAM_POLL_SECONDS=2
# Optional providers. Keep keys out of frontend configuration.
TRAM_WEATHERAPI_KEY=
TRAM_TIMEPAD_TOKEN=
TRAM_FRONTEND_DIST=frontend/dist
